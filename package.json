    "api-design",
    "git",
    "changelog",
    "claude-code",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devwangxiaogang/dsh-coding-skills.git"
  },
  "homepage": "https://github.com/devwangxiaogang/dsh-coding-skills#readme",
  "bugs": {
